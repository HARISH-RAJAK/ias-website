# Disable Directory Listing
Options -Indexes

# CORS Headers (redundancy for PHP)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "http://localhost:8000"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Handle OPTIONS requests for CORS preflight
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Protect .env files from browser access
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Route API and Backend requests to PHP Backend public/index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]
    RewriteRule ^backend/(.*)$ backend/public/index.php [QSA,L]
</IfModule>

# React Router fallback for Single Page Application
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
